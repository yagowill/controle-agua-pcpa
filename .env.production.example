APP_NAME="SCEA - PCPA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://scea.exemplo.pcpa.pa.gov.br

# Força URLs https (obrigatório atrás do Caddy).
APP_FORCE_HTTPS=true

# Domínio público utilizado pelo Caddy para emitir o certificado.
APP_DOMAIN=scea.exemplo.pcpa.pa.gov.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Aplicação -------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=scea
DB_USERNAME=scea
DB_PASSWORD=troque-esta-senha
DB_SSLMODE=prefer

# Banco externo (Neon, Aiven, Supabase) pode ser usado no lugar do serviço
# `postgres` do compose. Nesse caso, defina DB_URL e DB_SSLMODE=require.
# DB_URL=postgresql://usuario:senha@host/banco?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="scea@pcpa.pa.gov.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- Serviço PostgreSQL do compose.prod.yaml -------------------------------
# Mantenha os mesmos valores de DB_DATABASE, DB_USERNAME e DB_PASSWORD.
POSTGRES_DB=scea
POSTGRES_USER=scea
POSTGRES_PASSWORD=troque-esta-senha
