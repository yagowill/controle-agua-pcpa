# Variáveis equivalentes ao deploy do Fly.io + Neon.
#
# Este ficheiro serve de referência. No Fly.io:
#   - os valores públicos ficam em [env] no fly.toml;
#   - os segredos (APP_KEY e DB_URL) são definidos com `fly secrets set`.
#
# Não faça commit de credenciais reais.

APP_NAME="SCEA - PCPA"
APP_ENV=production
APP_DEBUG=false
APP_FORCE_HTTPS=true

# Reutilize a mesma APP_KEY usada atualmente em produção (Render) para
# preservar sessões/cookies e quaisquer valores cifrados. Para gerar uma nova:
#   docker run --rm php:8.4-cli -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=

# No Fly.io o domínio padrão é https://<FLY_APP_NAME>.fly.dev.
# Defina APP_URL apenas ao usar um domínio próprio.
APP_URL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Connection string direta do Neon em aws-sa-east-1 (sem o sufixo "-pooler").
# Codifique caracteres especiais da senha com URL encoding.
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:senha@ep-xxxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# true apenas em bases novas, para criar o administrador inicial.
# Com o banco de produção reaproveitado, mantenha false.
RUN_SEEDER=false

# Porta interna do Apache; deve coincidir com internal_port no fly.toml.
PORT=8080
