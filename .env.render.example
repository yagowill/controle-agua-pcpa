# Variáveis equivalentes ao deploy do Render + Neon.
#
# Este ficheiro serve de referência. No Render, os mesmos valores são
# definidos no dashboard (ou pelo render.yaml) e os segredos ficam em
# `sync: false`. Não faça commit de credenciais reais.

APP_NAME="SCEA - PCPA"
APP_ENV=production
APP_DEBUG=false
APP_FORCE_HTTPS=true

# Gere com:
#   docker compose -f compose.prod.yaml run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=

# Preenchido automaticamente pelo Render (RENDER_EXTERNAL_URL).
APP_URL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Connection string direta do Neon (sem o sufixo "-pooler").
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:senha@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

# true apenas no primeiro deploy, para criar o administrador inicial.
RUN_SEEDER=false
